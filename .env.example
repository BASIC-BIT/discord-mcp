SPRING_PROFILES_ACTIVE=http
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=
# Optional deployment guardrails. Unset preserves the original unrestricted behavior.
DISCORD_MCP_ALLOWED_GUILDS=
DISCORD_MCP_ALLOWED_TOOLS=
DISCORD_MCP_WRITE_MODE=allow
DISCORD_EXPECTED_BOT_ID=
# Request the matching Gateway intent only after enabling the Developer Portal grant.
# This is not an in-process filter for REST-fetched message content.
DISCORD_MCP_MESSAGE_CONTENT=false
