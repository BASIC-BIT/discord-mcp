SPRING_PROFILES_ACTIVE=http
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=
# Optional deployment guardrails. Unset preserves the original unrestricted behavior.
DISCORD_MCP_ALLOWED_GUILDS=
DISCORD_MCP_ALLOWED_TOOLS=
DISCORD_MCP_WRITE_MODE=allow
DISCORD_EXPECTED_BOT_ID=
# Mounted secret and audit paths; see README hardening instructions before enabling.
# DISCORD_MCP_ACCESS_TOKEN_FILE=/run/secrets/discord-mcp-access-token
# DISCORD_MCP_AUDIT_FILE=/var/lib/discord-mcp/audit.jsonl
# DISCORD_MCP_AUDIT_MAX_BYTES=10485760
